{
  "name": "ytomp3",
  "version": "0.1.2",
  "description": "Baixe áudio do YouTube e converta para MP3.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run tauri:dev",
    "build": "npm run build:ui",
    "build:ui": "tsc -p tsconfig.json && vite build",
    "tauri:dev": "npm run build:ui && tauri dev",
    "tauri:build": "npm run build:ui && tauri build --bundles nsis",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
