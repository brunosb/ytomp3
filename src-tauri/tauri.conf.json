{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YToMP3",
  "version": "0.1.0",
  "identifier": "com.bruno.ytomp3",
  "build": { "frontendDist": "../dist", "beforeBuildCommand": "npm run build:ui" },
  "app": { "windows": [{ "label": "main", "title": "YToMP3", "width": 820, "height": 620, "minWidth": 620, "minHeight": 560, "resizable": true, "decorations": true }], "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' https://fonts.googleapis.com; connect-src 'self' https://api.github.com https://github.com" } },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.ico"], "resources": ["bin/yt-dlp.exe", "bin/ffmpeg.exe"] }
}
